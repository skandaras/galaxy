# Where the SQLite DB, library, skills, uploads and themes live
DATA_DIR=./data

# Public URL of this instance. Required behind a reverse proxy —
# without it SvelteKit's CSRF check rejects multipart uploads (attachments).
ORIGIN=https://ai.starbasehome.net

# dev | prod — cosmetic label shown in the UI shell
GALAXY_ENV=dev

# authelia | dev
#   authelia: identity comes from Remote-User/Remote-Email/Remote-Groups headers,
#             accepted only when the request's peer address is in TRUSTED_PROXY_IPS
#   dev:      every request is authenticated as DEV_USER (local development only)
AUTH_MODE=dev
DEV_USER=dev

# Comma-separated IPs or IPv4 CIDRs allowed to supply auth headers (the reverse proxy)
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Authelia group whose members get the admin role
ADMIN_GROUP=galaxy-admins
