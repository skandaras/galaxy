# Where the SQLite DB, library, skills, uploads and themes live
DATA_DIR=./data

# Public URL of this instance. Required behind a reverse proxy —
# without it SvelteKit's CSRF check rejects multipart uploads (attachments).
ORIGIN=https://ai.starbasehome.net

# Largest request body the server will accept. adapter-node defaults to 512K,
# which silently breaks attachment uploads well below the app's own limits
# (5 MB images, 25 MB documents) — the other way uploads fail besides ORIGIN.
BODY_SIZE_LIMIT=32M

# dev | prod — cosmetic label shown in the UI shell
GALAXY_ENV=dev

# authelia | dev
#   authelia: identity comes from Remote-User/Remote-Email/Remote-Groups headers,
#             accepted only when the request's peer address is in TRUSTED_PROXY_IPS
#   dev:      every request is authenticated as DEV_USER (local development only)
AUTH_MODE=dev
DEV_USER=dev

# Required by the searxng service in docker-compose.yml, which refuses to start
# without it. Generate once: openssl rand -hex 32
SEARXNG_SECRET=

# Comma-separated IPs or IPv4 CIDRs allowed to supply auth headers (the reverse proxy)
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Authelia group whose members get the admin role
ADMIN_GROUP=galaxy-admins

# Android app (Trusted Web Activity), both unset until you build one with
# scripts/build-twa.sh — which prints the fingerprint to paste here. Together
# they are served at /.well-known/assetlinks.json, which is what stops the
# installed app drawing a browser address bar over itself.
TWA_PACKAGE_ID=
TWA_FINGERPRINTS=
